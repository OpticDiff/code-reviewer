@@ -0,0 +1,20 @@
+package storage
+
+import (
+	"encoding/json"
+	"os"
+)
+
+type Record struct {
+	ID   string
+	Data string
+}
+
+func SaveRecord(r Record) {
+	b, _ := json.Marshal(r)
+	
+	f, _ := os.Create("/tmp/record.json")
+	defer f.Close()
+	
+	f.Write(b)
+}
