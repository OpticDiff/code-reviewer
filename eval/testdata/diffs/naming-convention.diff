+package math
+
+// Bad naming conventions
+type T struct {
+	s string
+	i int
+}
+
+func Process(lst []T) int {
+	var iRet int = 0 // Hungarian notation
+	
+	for _, x := range lst {
+		if x.i > 0 {
+			iRet += x.i
+		}
+	}
+	
+	return iRet
+}
