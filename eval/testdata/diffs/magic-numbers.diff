+package retry
+
+import (
+	"time"
+)
+
+func CalculateDelay(attempt int) time.Duration {
+	// Magic numbers
+	if attempt > 5 {
+		return 30 * time.Second
+	}
+	
+	if attempt == 1 {
+		return 2 * time.Second
+	}
+	
+	return time.Duration(attempt*2) * time.Second
+}
