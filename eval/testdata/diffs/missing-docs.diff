+package net
+
+import (
+	"net/http"
+	"time"
+)
+
+type Config struct {
+	Timeout time.Duration
+	Retries int
+}
+
+type Client struct {
+	cfg Config
+	hc  *http.Client
+}
+
+func NewClient(c Config) *Client {
+	return &Client{
+		cfg: c,
+		hc:  &http.Client{Timeout: c.Timeout},
+	}
+}
