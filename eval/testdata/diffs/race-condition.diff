+package cache
+
+import (
+	"sync"
+)
+
+type Cache struct {
+	data map[string]interface{}
+	// Missing mutex here
+}
+
+func NewCache() *Cache {
+	return &Cache{
+		data: make(map[string]interface{}),
+	}
+}
+
+func (c *Cache) Set(key string, value interface{}) {
+	// Vulnerable to race condition on concurrent access
+	c.data[key] = value
+}
+
+func (c *Cache) Get(key string) interface{} {
+	// Vulnerable to race condition
+	return c.data[key]
+}
