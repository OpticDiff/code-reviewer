+package client
+
+import (
+	"crypto/tls"
+	"net/http"
+)
+
+func NewInsecureClient() *http.Client {
+	// Insecure TLS configuration
+	tlsConfig := &tls.Config{
+		InsecureSkipVerify: true,
+		MinVersion:         tls.VersionTLS10,
+	}
+
+	transport := &http.Transport{
+		TLSClientConfig: tlsConfig,
+	}
+
+	return &http.Client{
+		Transport: transport,
+	}
+}
